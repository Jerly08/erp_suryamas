# ================================================================
# PRODUCTION CONFIGURATION TEMPLATE
# Copy this file to .env for production deployment
# ================================================================

# Database Configuration (WAJIB - format URL untuk app utama)
# Format: postgres://username:password@host:port/database?sslmode=disable
DATABASE_URL=postgres://postgres:GantiDenganPasswordSuperKuat@localhost:5432/sistem_akuntansi?sslmode=disable

# Database Credentials (untuk maintenance scripts)
DB_USER=postgres
DB_PASSWORD=GantiDenganPasswordSuperKuat
DB_NAME=sistem_akuntansi

# JWT Secrets (HARUS KUAT MINIMAL 32 KARAKTER)
JWT_SECRET=GenerateStringAcakSuperKuatPanjangRahasia!
JWT_ACCESS_SECRET=GenerateStringAcakSuperKuatPanjangRahasia!
JWT_REFRESH_SECRET=GenerateStringAcakSuperKuatPanjangRahasiaRefresh!

# Session Secret
SESSION_SECRET=GenerateStringAcakSuperKuatPanjangRahasiaSession!

# Pengaturan Lingkungan
ENVIRONMENT=production
SERVER_PORT=8080
GIN_MODE=release

# Pengaturan Domain & CORS
DOMAIN=vps-domain-anda.com
APP_URL=http://ip-vps-anda:3003
FRONTEND_URL=http://localhost:3003
ALLOWED_ORIGINS=http://ip-vps-anda:3003,http://vps-domain-anda.com,http://localhost:3003,http://localhost:3000

# Production Flags
SKIP_BALANCE_RESET=false
ENABLE_LEGACY_PAYMENT_JOURNALS=true
ENABLE_SSOT_PAYMENT_JOURNALS=true

# Logging
LOG_LEVEL=warn