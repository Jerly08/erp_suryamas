# Staging deployment without reverse proxy / TLS.
# Access app directly via http://SERVER_IP:3003 and API via http://SERVER_IP:8084

# Database
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=sistem_akuntansi

# App mode
ENVIRONMENT=staging
GIN_MODE=release
SERVER_PORT=8080

# Secrets, use real random values
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
SESSION_SECRET=replace-with-a-long-random-session-secret

# Frontend / CORS
FRONTEND_URL=http://SERVER_IP:3003
ALLOWED_ORIGINS=http://SERVER_IP:3003,http://localhost:3003,http://127.0.0.1:3003

# Optional
ENABLE_SWAGGER=false
LOG_LEVEL=info
