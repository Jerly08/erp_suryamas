{
	email {$ACME_EMAIL}
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size {$CLIENT_MAX_BODY_SIZE}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
	}

	# This app does not intentionally use Next.js Server Actions.
	# Block public Server Action probes that can be abused to drop runtime payloads.
	@nextAction header Next-Action *
	respond @nextAction "Forbidden" 403

	# Next.js internal recursion header must never be trusted from the public edge.
	@middlewareSubrequest header x-middleware-subrequest *
	respond @middlewareSubrequest "Forbidden" 403

	@api path /api/*
	reverse_proxy @api backend:8080

	@uploads path /uploads/*
	reverse_proxy @uploads backend:8080

	reverse_proxy frontend:3000

	log {
		output stdout
		format console
	}
}
